formulas:
  tag: ""
views:
  - type: table
    name: Table
    order:
      - file.name
      - file.links
  - type: cards
    name: View
    filters:
      and:
        - file.folder.contains("resources")
    order:
      - file.name
      - formula.tag
    cardSize: 270
  - type: cards
    name: View 2
